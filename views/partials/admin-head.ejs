<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Africom Hotspot</title>
  <link rel="icon" href="/images/africom-logo.jpeg">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/dashboard.css">
</head>
<body class="dashboard">
  <div class="dash-layout">
    <aside class="dash-sidebar">
      <div class="sidebar-logo">
        <div class="mark"><img src="/images/africom-logo.jpeg" alt="Africom"></div>
        <div>
          <div class="word">africom</div>
          <div class="tagline">Hotspot</div>
        </div>
      </div>
      <nav>
        <a href="/admin" class="<%= activePage === 'overview' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>
          <span class="nav-label">Overview</span>
        </a>
        <a href="/admin/subscribers" class="<%= activePage === 'subscribers' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 5 18.5V20"/><circle cx="9.5" cy="8" r="3.2"/><path d="M19 20v-1.5a3.4 3.4 0 0 0-2.4-3.26"/><path d="M14.8 4.9a3.2 3.2 0 0 1 0 6.2"/></svg>
          <span class="nav-label">Subscribers</span>
        </a>
        <a href="/admin/revenue" class="<%= activePage === 'revenue' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5.5-5.5 4 4L21 7"/><path d="M15 7h6v6"/></svg>
          <span class="nav-label">Revenue</span>
        </a>
        <a href="/admin/vouchers" class="<%= activePage === 'vouchers' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V15a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3z"/><path d="M10 7v10" stroke-dasharray="2 2"/></svg>
          <span class="nav-label">Vouchers</span>
        </a>
        <a href="/admin/live" class="<%= activePage === 'live' ? 'active' : '' %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.2 15.8a5.6 5.6 0 0 1 7.6 0"/><circle cx="12" cy="19" r="1.2" fill="currentColor" stroke="none"/></svg>
          <span class="nav-label">Live</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5a10 10 0 0 1 14 0"/><path d="M8.2 15.8a5.6 5.6 0 0 1 7.6 0"/><circle cx="12" cy="19" r="1.2" fill="currentColor" stroke="none"/></svg>
        <div>
          <div class="t">Africom Network</div>
          <div class="s">Powering connections across Africa.</div>
        </div>
      </div>
    </aside>
    <main class="dash-main">
      <div class="dash-topbar">
        <span><%= title %></span>
        <span><a href="/admin/logout">Log out</a></span>
      </div>
