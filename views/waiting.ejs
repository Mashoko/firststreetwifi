<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirm payment · Africom Hotspot</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" href="/images/africom-logo.jpeg">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <div class="brand">
      <div class="mark"><img src="/images/africom-logo.jpeg" alt="Africom" width="42" height="42"></div>
      <div><h1>Africom Hotspot</h1><div class="sub">Confirm your payment</div></div>
    </div>

    <div class="card center" id="pending">
      <div class="spinner"></div>
      <h2><%= pkg.name %> — $<%= pkg.price.toFixed(2) %></h2>
      <p class="lead" style="margin-top:8px"><%= instructions || 'Check your phone and approve the payment prompt.' %></p>
      <p class="note">Keep this page open. We'll connect you automatically once payment is confirmed.</p>
    </div>

    <div class="card center" id="done" style="display:none">
      <div class="big-icon">🎉</div>
      <h2>You're connected!</h2>
      <p class="lead" id="doneAllowance"></p>
      <p class="lead">Your voucher code (save it):</p>
      <div class="voucher-code" id="voucherCode">—</div>
      <p class="note">You now have internet access. Enjoy!</p>
    </div>

    <div class="card center" id="failed" style="display:none">
      <div class="big-icon">⚠️</div>
      <h2>Payment not completed</h2>
      <p class="lead msg-err">We couldn't confirm your payment. No charge was made.</p>
      <a href="/" class="btn" style="text-decoration:none;margin-top:10px">Try again</a>
    </div>
  </div>

  <script>
    const reference = <%- JSON.stringify(reference) %>;
    let attempts = 0;
    const maxAttempts = 40; // ~2 minutes at 3s

    async function poll() {
      attempts++;
      try {
        const res = await fetch('/pay/status/' + encodeURIComponent(reference));
        const data = await res.json();
        if (data.status === 'paid') {
          document.getElementById('pending').style.display = 'none';
          document.getElementById('voucherCode').textContent = data.voucher || '—';
          const allowanceEl = document.getElementById('doneAllowance');
          allowanceEl.textContent = data.dataGB ? (data.name + ' — ' + data.dataGB + 'GB') : '';
          document.getElementById('done').style.display = 'block';
          return;
        }
      } catch (e) { /* keep polling */ }

      if (attempts >= maxAttempts) {
        document.getElementById('pending').style.display = 'none';
        document.getElementById('failed').style.display = 'block';
        return;
      }
      setTimeout(poll, 3000);
    }
    setTimeout(poll, 3000);
  </script>
</body>
</html>
