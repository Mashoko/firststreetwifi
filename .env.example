# ─────────────────────────────────────────────
#  First Street WiFi — Environment Configuration
# ─────────────────────────────────────────────

# App
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
BASE_URL=http://localhost:3000
# Set to "true" to run without real Omada/Paynow calls (safe for local dev)
MOCK_MODE=true

# ── Paynow (get these from https://paynow.co.zw merchant dashboard) ──
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
# Test-mode auth email must match a login email on your Paynow merchant account
PAYNOW_AUTH_EMAIL=you@example.com

# ── Omada Controller ──
# CONTROLLER_TYPE: "software" (self-hosted) or "cloud" (TP-Link hosted)
OMADA_CONTROLLER_TYPE=software
# For software controller: https://192.168.0.10:8043  (your controller IP + https port)
# For cloud controller: https://aps1-omada-northbound.tplinkcloud.com (region-specific base)
OMADA_BASE_URL=https://192.168.0.10:8043
# Controller ID — found in your controller URL after login, e.g.
#   https://CONTROLLER:PORT/<CONTROLLER_ID>/...   (v5.0.15+ requires this)
OMADA_CONTROLLER_ID=your_controller_id
# Site name as shown in Omada (usually "Default")
OMADA_SITE=Default
# Hotspot OPERATOR account (created under Hotspot Manager, NOT the admin login)
OMADA_OPERATOR_USER=portal_operator
OMADA_OPERATOR_PASS=operator_password
# Set to "false" only if your controller uses a valid TLS cert (self-signed => keep false)
OMADA_VERIFY_TLS=false

# ── Admin dashboard (/admin) ──
# Required to log in to the reports page. Leave unset to keep /admin disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password

# ── ERPNext (Africom accounting integration) ──
# Existing integration user: hotspot.integration@afri-com.net
# Get these from whoever manages that user in ERPNext — do not create a new user.
ERPNEXT_BASE_URL=https://erp.ai.co.zw
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret
